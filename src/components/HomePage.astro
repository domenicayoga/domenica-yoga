---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { content, type Lang } from '../data/locales';
import { aboutPath, homeAlternates, socialsFor } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const c = content[lang];
const socials = socialsFor(lang);
const serviceImgs = ['/assets/group.webp','/assets/individual.webp','/assets/course.webp'];
const resourceImgs = ['/assets/resource1.webp','/assets/resource2.webp','/assets/resource3.webp'];
const altNames = { en:'Domenica practicing yoga by the Atlantic Ocean', fr:'Domenica pratiquant le yoga au bord de l’océan Atlantique', ua:'Доменіка практикує йогу біля Атлантичного океану' };
---
<BaseLayout lang={lang} title={c.title} description={c.description} canonicalPath={`/${lang}/`} alternatePaths={homeAlternates}>
<SiteHeader lang={lang} />
<main id="top">
  <section class="hero"><div class="shell"><div class="hero-copy">
    <div class="eyebrow">{c.hero.eyebrow}</div><h1>{c.hero.title}</h1><p>{c.hero.text}</p>
    <div class="actions"><a class="btn primary" href="#training">{c.hero.primary}</a><a class="btn" href="#training">{c.hero.secondary}</a></div>
    <div class="micro">{c.hero.micro}</div>
  </div></div></section>

  <section class="philosophy"><div class="shell philosophy-grid"><h2>{c.philosophy.title}</h2><div class="pillars">
    {c.philosophy.pillars.map((p,i)=><div class="pillar"><div class="icon">{['✓','↗','○'][i]}</div><h3>{p[0]}</h3><p>{p[1]}</p></div>)}
  </div></div></section>

  <section class="problem"><div class="bg"></div><div class="shell"><h2>{c.problem.title}</h2><div class="checks">{c.problem.items.map(i=><div class="check">{i}</div>)}</div><p class="problem-line">{c.problem.line}</p></div></section>

  <section class="services" id="training"><div class="shell"><div class="eyebrow">{c.services.eyebrow}</div><h2>{c.services.title}</h2><div class="service-grid">
    {c.services.items.map((s,i)=><article class="card" id={i===2?'course':undefined}><div class="card-media"><img src={serviceImgs[i]} alt={altNames[lang]} loading="lazy" /></div><div class="card-body"><h3>{s[0]}</h3><p>{s[1]}</p><a class="text-link" href="#contact">{s[2]}</a></div></article>)}
  </div></div></section>

  <section class="about" id="about"><div class="shell about-grid"><div class="about-photo"><img src="/assets/about.webp" alt={altNames[lang]} loading="lazy" /></div><div class="about-copy"><div class="eyebrow">{c.about.eyebrow}</div><h2>{c.about.title}</h2><p>{c.about.p1}</p><p>{c.about.p2}</p><a class="btn primary" href={aboutPath(lang)}>{c.about.button}</a></div></div></section>

  <section class="method"><div class="shell"><div class="eyebrow">{c.method.eyebrow}</div><h2>{c.method.title}</h2><div class="steps">{c.method.items.map((s,i)=><div class="step"><div class="num">0{i+1}</div><h3>{s[0]}</h3><p>{s[1]}</p></div>)}</div></div></section>

  <section class="testimonials"><div class="shell testimonial-grid"><div><div class="eyebrow">{c.testimonials.eyebrow}</div><h2>{c.testimonials.title}</h2></div>{c.testimonials.items.map(q=><div class="quote"><p>{q}</p><small>— client story</small></div>)}</div></section>

  <section class="resources" id="resources"><div class="shell resource-layout"><div><div class="eyebrow">{c.resources.eyebrow}</div><h2>{c.resources.title}</h2><p>{c.resources.text}</p><a class="text-link" href="#">{c.resources.all}</a></div><div class="resource-grid">{c.resources.items.map((r,i)=><article class="resource-card"><div class="resource-img"><img src={resourceImgs[i]} alt={altNames[lang]} loading="lazy" /></div><div class="resource-copy"><h3>{r}</h3><small>Guide</small></div></article>)}</div></div></section>

  <section class="final-cta" id="contact"><div class="bg"></div><div class="shell"><h2>{c.final.title}</h2><p>{c.final.text}</p><div class="actions"><a class="btn light" href={socials.instagram} target="_blank" rel="noopener">Instagram ↗</a><a class="btn light" href={socials.telegram} target="_blank" rel="noopener">Telegram ↗</a></div></div></section>
</main>
<SiteFooter lang={lang} />
</BaseLayout>
