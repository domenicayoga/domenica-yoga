---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { content, type Lang } from '../data/locales';
import { aboutPath, groupPath, individualPath, coursePath, resourcesPath, contactPath, homeAlternates, socialsFor, primaryContact } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const c = content[lang];
const socials = socialsFor(lang);
const contact = primaryContact(lang);
const serviceImgs = ['/assets/group-v04.webp','/assets/individual-v04.webp','/assets/course-v04.webp'];
const serviceLinks = [groupPath(lang), individualPath(lang), coursePath(lang)];
const resourceImgs = ['/assets/resource1-v04.webp','/assets/resource2-v04.webp','/assets/resource3-v04.webp'];
const altNames = { en:'Domenica practicing yoga by the Atlantic Ocean', fr:'Domenica pratiquant le yoga au bord de l’océan Atlantique', ua:'Доменіка практикує йогу біля Атлантичного океану' };
---
<BaseLayout lang={lang} title={c.title} description={c.description} canonicalPath={`/${lang}/`} alternatePaths={homeAlternates} ogImage="/assets/og-domenica-v04.jpg">
<SiteHeader lang={lang} active="home" />
<main id="top">
  <section class="hero hero-v04"><div class="shell"><div class="hero-copy">
    <div class="eyebrow">{c.hero.eyebrow}</div><h1>{c.hero.title}</h1><p>{c.hero.text}</p>
    <div class="actions"><a class="btn primary" href={groupPath(lang)}>{c.hero.primary}</a><a class="btn" href="#training">{c.hero.secondary}</a></div>
    <div class="micro">{c.hero.micro}</div>
  </div></div></section>

  <section class="philosophy"><div class="shell philosophy-grid"><h2>{c.philosophy.title}</h2><div class="pillars">
    {c.philosophy.pillars.map((p,i)=><div class="pillar"><div class="icon">{['↗','＋','○'][i]}</div><h3>{p[0]}</h3><p>{p[1]}</p></div>)}
  </div></div></section>

  <section class="problem problem-v04"><div class="bg"></div><div class="shell"><h2>{c.problem.title}</h2><div class="checks">{c.problem.items.map(i=><div class="check">{i}</div>)}</div><p class="problem-line">{c.problem.line}</p></div></section>

  <section class="services" id="training"><div class="shell"><div class="eyebrow">{c.services.eyebrow}</div><h2>{c.services.title}</h2><div class="service-grid">
    {c.services.items.map((s,i)=><article class="card" id={i===2?'course':undefined}><a href={serviceLinks[i]} class="card-media"><img src={serviceImgs[i]} alt={altNames[lang]} loading="lazy" /></a><div class="card-body"><div class="service-price">{s[3]}</div><h3>{s[0]}</h3><p>{s[1]}</p><a class="text-link" href={serviceLinks[i]}>{s[2]}</a></div></article>)}
  </div></div></section>

  <section class="about" id="about"><div class="shell about-grid"><div class="about-photo"><img src="/assets/about-v04.webp" alt={altNames[lang]} loading="lazy" /></div><div class="about-copy"><div class="eyebrow">{c.about.eyebrow}</div><h2>{c.about.title}</h2><p>{c.about.p1}</p><p>{c.about.p2}</p><a class="btn primary" href={aboutPath(lang)}>{c.about.button}</a></div></div></section>

  <section class="method"><div class="shell"><div class="eyebrow">{c.method.eyebrow}</div><h2>{c.method.title}</h2><div class="steps">{c.method.items.map((s,i)=><div class="step"><div class="num">0{i+1}</div><h3>{s[0]}</h3><p>{s[1]}</p></div>)}</div></div></section>

  <section class="testimonials"><div class="shell">
    <div class="outcome-heading"><div class="eyebrow">{c.testimonials.eyebrow}</div><h2>{c.testimonials.title}</h2></div>
    <div class="outcome-grid">{c.testimonials.items.map((q,i)=><article class="outcome-card"><span class="outcome-num">0{i+1}</span><p>{q}</p></article>)}</div>
  </div></section>

  <section class="resources" id="resources"><div class="shell">
    <div class="resource-heading"><div class="eyebrow">{c.resources.eyebrow}</div><h2>{c.resources.title}</h2><p>{c.resources.text}</p><a class="text-link muted-link" href={resourcesPath(lang)}>{c.resources.all} →</a></div>
    <div class="resource-grid resource-grid-balanced">{c.resources.items.map((r,i)=><article class="resource-card"><div class="resource-img"><img class:list={[i===2 && 'mirror-image']} src={resourceImgs[i]} alt={altNames[lang]} loading="lazy" /></div><div class="resource-copy"><h3>{r}</h3><small>{lang==='fr'?'Guide · bientôt':lang==='ua'?'Гайд · скоро':'Guide · coming soon'}</small></div></article>)}</div>
  </div></section>

  <section class="final-cta final-cta-v04" id="contact"><div class="bg"></div><div class="shell"><h2>{c.final.title}</h2><p>{c.final.text}</p><div class="actions"><a class="btn light" href={contact.href} target="_blank" rel="noopener">{c.final.button} — {contact.label} ↗</a><a class="btn light" href={contactPath(lang)}>Contact</a></div></div></section>
</main>
<SiteFooter lang={lang} />
</BaseLayout>
