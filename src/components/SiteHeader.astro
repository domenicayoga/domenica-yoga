---
import type { Lang } from '../data/locales';
import { content } from '../data/locales';
import { homePath, aboutPath } from '../data/site';
const { lang, active = '' } = Astro.props as { lang: Lang; active?: 'about' | '' };
const c = content[lang];
const languageTarget = (l: Lang) => active === 'about' ? aboutPath(l) : homePath(l);
---
<header class="site-header">
  <div class="shell"><nav>
    <a class="brand" href={homePath(lang)}>DOMENICA YOGA</a>
    <div class="navlinks">
      <a class:list={[active==='about' && 'active']} href={aboutPath(lang)}>{c.nav.about}</a>
      <a href={`${homePath(lang)}#training`}>{c.nav.training}</a>
      <a href={`${homePath(lang)}#course`}>{c.nav.course}</a>
      <a href={`${homePath(lang)}#resources`}>{c.nav.resources}</a>
      <a href={`${homePath(lang)}#contact`}>{c.nav.contact}</a>
    </div>
    <div class="lang" aria-label="Language switcher">
      {(['en','fr','ua'] as Lang[]).map((l) => <a class:list={[l===lang && 'active']} href={languageTarget(l)}>{l==='ua'?'UA':l.toUpperCase()}</a>)}
    </div>
  </nav></div>
</header>
