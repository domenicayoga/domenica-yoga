---
import '../styles/global.css';
import { localeMeta, type Lang } from '../data/locales';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}
const { lang, title, description } = Astro.props;
const base = Astro.site ?? new URL('https://example.com');
const canonical = new URL(`/${lang}/`, base);
const alternates = {
  en: new URL('/en/', base),
  fr: new URL('/fr/', base),
  ua: new URL('/ua/', base)
};
const meta = localeMeta[lang];
---
<!doctype html>
<html lang={meta.code}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f2efe8" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={alternates.en} />
  <link rel="alternate" hreflang="fr" href={alternates.fr} />
  <link rel="alternate" hreflang="uk" href={alternates.ua} />
  <link rel="alternate" hreflang="x-default" href={alternates.en} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={meta.ogLocale} />
  <meta property="og:image" content={new URL('/assets/hero.webp', base)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL('/assets/hero.webp', base)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context':'https://schema.org',
    '@type':'Person',
    name:'Domenica',
    url: canonical.href,
    jobTitle: lang === 'fr' ? 'Professeure de yoga et spécialiste du mouvement' : lang === 'ua' ? 'Інструкторка йоги та спеціалістка з руху' : 'Yoga teacher and movement specialist'
  })} />
</head>
<body><slot /></body>
</html>
